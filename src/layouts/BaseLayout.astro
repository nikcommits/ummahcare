---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link
      rel="icon"
      type="image/png"
      href={`${base}/images/ummahcare-logo.png`}
    />
    <link
      rel="preload"
      href={`${base}/fonts/inclusive-sans-variable.ttf`}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen break-words bg-canvas font-sans text-ink antialiased selection:bg-teal-brand selection:text-ink"
  >
    <a
      href="#hauptinhalt"
      class="fixed top-3 left-3 z-50 -translate-y-24 rounded-lg bg-ink px-4 py-3 font-semibold text-white transition-transform focus:translate-y-0 focus:outline-3 focus:outline-offset-2 focus:outline-ink motion-reduce:transition-none"
    >
      Zum Hauptinhalt
    </a>
    <Header />
    <main id="hauptinhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
