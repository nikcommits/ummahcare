---
import { getCollection } from 'astro:content';
import BoundaryPanel from '../components/BoundaryPanel.astro';
import FaqList from '../components/FaqList.astro';
import HomeHero from '../components/HomeHero.astro';
import PersonCard from '../components/PersonCard.astro';
import VideoLinks from '../components/VideoLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('home');
const page = entries.find((entry) => entry.id === 'startseite');

if (!page) throw new Error('Startseiten-Content fehlt.');

const { data } = page;
---

<BaseLayout title={data.meta.title} description={data.meta.description}>
  <HomeHero hero={data.hero} paths={data.paths} />

  <section class="border-y border-ink/10 bg-white">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <div class="max-w-[760px]">
        <h2
          class="text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl"
        >
          {data.belief.title}
        </h2>
        <div class="mt-7 space-y-5 text-lg leading-relaxed text-ink-soft">
          {data.belief.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <VideoLinks videos={data.videos} />

  <section id="begleitung" class="scroll-mt-8">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <h2
        class="max-w-3xl text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl"
      >
        {data.topics.title}
      </h2>
      <div class="mt-10 grid gap-x-12 gap-y-0 md:grid-cols-2">
        {
          data.topics.items.map((item) => (
            <article class="border-t border-ink/20 py-7">
              <h3 class="text-2xl font-semibold">{item.title}</h3>
              <p class="mt-3 max-w-[52ch] text-lg leading-relaxed text-ink-soft">
                {item.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <BoundaryPanel
    title={data.boundary.title}
    paragraphs={data.boundary.paragraphs}
    crisisLead={data.boundary.crisisLead}
    crisisPlaceholder={data.boundary.crisisPlaceholder}
  />

  <section class="bg-canvas">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <h2
        class="max-w-3xl text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl"
      >
        {data.peopleTitle}
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {data.people.map((person) => <PersonCard person={person} />)}
      </div>
    </div>
  </section>

  <section id="ablauf" class="scroll-mt-8 border-y border-ink/10 bg-white">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <h2
        class="max-w-3xl text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl"
      >
        {data.process.title}
      </h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 xl:grid-cols-4">
        {
          data.process.steps.map((step, index) => (
            <li class="border-t border-ink/25 pt-5">
              <span
                class="grid size-10 place-items-center rounded-full bg-teal-brand text-lg font-semibold"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="mt-5 text-2xl leading-tight font-semibold">
                {step.title}
              </h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-canvas">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <div
        class="grid gap-8 rounded-2xl bg-teal-brand p-6 md:grid-cols-[0.7fr_1.3fr] md:p-10"
      >
        <h2
          class="text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance"
        >
          {data.privacy.title}
        </h2>
        <div class="space-y-4 text-lg leading-relaxed text-ink-soft">
          {data.privacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <FaqList title={data.faq.title} items={data.faq.items} />

  <section class="bg-canvas">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <div class="max-w-3xl">
        <h2
          class="text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl"
        >
          {data.closing.title}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          {data.closing.text}
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          data.paths.map((path) => (
            <a
              href={`#${path.id === 'schwestern' ? 'jessica' : 'mario'}`}
              class="grid min-h-24 gap-1 rounded-2xl border border-ink bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-ambient focus:outline-3 focus:outline-offset-3 focus:outline-ink motion-reduce:transform-none motion-reduce:transition-none"
            >
              <span class="font-medium text-ink-soft">{path.label}</span>
              <strong class="text-xl">{path.person}</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
