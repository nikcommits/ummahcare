---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('legal');
  return entries.map((entry) => ({
    params: { legal: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout title={`${data.title} | UmmahCare`} description={data.description}>
  <section
    class="mx-auto min-h-[60vh] w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
  >
    <p class="font-semibold text-ink-soft">Rechtliche Pflichtseite</p>
    <h1
      class="mt-4 text-[clamp(2.5rem,7vw,5rem)] leading-[1.04] font-semibold tracking-[-0.03em]"
    >
      {data.title}
    </h1>
    <div
      class="mt-8 max-w-3xl rounded-2xl border border-danger/35 bg-white p-6 md:p-8"
    >
      <h2 class="text-2xl font-semibold text-danger">
        Noch nicht veröffentlichungsfähig
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{data.notice}</p>
    </div>
    {
      data.externalServices && (
        <div class="mt-8 max-w-3xl space-y-6">
          {data.externalServices.map((service) => (
            <section class="rounded-2xl border border-ink/20 bg-white p-6 md:p-8">
              <h2 class="text-2xl font-semibold">{service.title}</h2>
              <div class="mt-4 space-y-4 text-lg leading-relaxed text-ink-soft">
                {service.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <a
                href={service.privacyUrl}
                target="_blank"
                rel="external noopener noreferrer"
                class="mt-5 inline-flex min-h-12 items-center font-semibold underline decoration-2 underline-offset-5 focus:outline-3 focus:outline-offset-3 focus:outline-ink"
              >
                {service.privacyLabel}
                <span class="sr-only"> (öffnet extern in einem neuen Tab)</span>
              </a>
            </section>
          ))}
        </div>
      )
    }
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`}
      class="mt-8 inline-flex min-h-12 items-center rounded-lg font-semibold underline decoration-2 underline-offset-5 focus:outline-3 focus:outline-offset-3 focus:outline-ink"
    >
      Zurück zur Startseite
    </a>
  </section>
</BaseLayout>
