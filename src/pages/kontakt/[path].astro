---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BoundaryPanel from '../../components/BoundaryPanel.astro';
import ContactAction from '../../components/ContactAction.astro';
import ContactForm from '../../components/ContactForm.astro';
import ContactHero from '../../components/ContactHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('contact');
  return entries.map((entry) => ({
    params: { path: entry.data.path },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout title={data.meta.title} description={data.meta.description}>
  <ContactHero data={data} />

  <div
    class="mx-auto grid w-full max-w-[1200px] gap-6 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-2 xl:px-12"
  >
    <ContactAction
      title={data.booking.title}
      text={data.booking.text}
      label={data.booking.label}
      help={data.booking.help}
      href={data.booking.href}
      secondary={data.booking.secondary}
      missing="Buchungslink fehlt noch."
      primary
    />
    <ContactAction
      title={data.whatsapp.title}
      text={data.whatsapp.text}
      label={data.whatsapp.label}
      help={data.whatsapp.help}
      href={data.whatsapp.href}
      missing="WhatsApp-Nummer fehlt noch."
    />
  </div>

  <div
    class="mx-auto w-full max-w-[1200px] px-5 pb-16 md:px-8 md:pb-24 xl:px-12"
  >
    <ContactForm
      path={data.path}
      title={data.form.title}
      text={data.form.text}
      fields={data.form.fields}
      privacyPlaceholder={data.form.privacyPlaceholder}
      submitLabel={data.form.submitLabel}
      unavailable={data.form.unavailable}
    />
  </div>

  <BoundaryPanel
    title={data.boundary.title}
    text={data.boundary.text}
    crisisPlaceholder={data.boundary.crisisPlaceholder}
  />

  <section class="bg-canvas">
    <div
      class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
    >
      <h2
        class="text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance"
      >
        {data.closing.title}
      </h2>
      <ul class="mt-7 grid gap-3 text-lg sm:grid-cols-3">
        {
          data.closing.actions.map((action) => (
            <li class="rounded-xl border border-ink/20 bg-white p-4 font-semibold">
              {action}
            </li>
          ))
        }
      </ul>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`}
        class="mt-8 inline-flex min-h-12 items-center rounded-lg font-semibold underline decoration-2 underline-offset-5 focus:outline-3 focus:outline-offset-3 focus:outline-ink"
      >
        Zurück zur Startseite
      </a>
    </div>
  </section>
</BaseLayout>
