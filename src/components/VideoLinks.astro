---
import type { CollectionEntry } from 'astro:content';

type Videos = CollectionEntry<'home'>['data']['videos'];

interface Props {
  videos: Videos;
}

const { videos } = Astro.props;
---

<section class="border-y border-ink/10 bg-canvas">
  <div
    class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-8 md:py-24 xl:px-12"
  >
    <div class="max-w-3xl">
      <h2
        class="text-4xl leading-tight font-semibold tracking-[-0.02em] text-balance md:text-5xl"
      >
        {videos.title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">{videos.intro}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        videos.items.map((video) => (
          <article class="flex flex-col rounded-2xl border border-ink/20 bg-white p-6 md:p-8">
            <p class="font-semibold text-ink-soft">Video auf YouTube</p>
            <h3 class="mt-2 text-3xl leading-tight font-semibold tracking-[-0.02em]">
              {video.title}
            </h3>
            <p class="mt-4 text-lg leading-relaxed text-ink-soft">
              {video.summary}
            </p>
            {video.note && (
              <p class="mt-4 rounded-xl bg-teal-soft p-4 leading-relaxed text-ink-soft">
                {video.note}
              </p>
            )}
            <div class="mt-auto pt-8">
              <a
                href={video.href}
                target="_blank"
                rel="external noopener noreferrer"
                class="flex min-h-13 items-center justify-center rounded-xl border border-ink bg-white px-5 py-3 text-center font-semibold text-ink hover:bg-teal-soft focus:outline-3 focus:outline-offset-3 focus:outline-ink"
              >
                {video.label}
                <span class="sr-only">
                  {' '}
                  (öffnet YouTube extern in einem neuen Tab)
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-ink-soft">
      {videos.privacyNote}
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/datenschutz/`}
        class="ml-1 font-semibold underline decoration-2 underline-offset-4 focus:outline-3 focus:outline-offset-3 focus:outline-ink"
      >
        Mehr zum Datenschutz
      </a>
    </p>
  </div>
</section>
