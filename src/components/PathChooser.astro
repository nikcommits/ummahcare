---
import type { CollectionEntry } from 'astro:content';

type Path = CollectionEntry<'home'>['data']['paths'][number];

interface Props {
  title: string;
  text: string;
  paths: Path[];
  compact?: boolean;
}

const { title, text, paths, compact = false } = Astro.props;
---

<section
  id="gespraechsweg"
  aria-labelledby="gespraechsweg-titel"
  class:list={[compact ? '' : 'scroll-mt-8']}
>
  <div class="max-w-2xl">
    <h2
      id="gespraechsweg-titel"
      class:list={[
        'font-semibold tracking-[-0.02em] text-balance',
        compact ? 'text-2xl' : 'text-3xl sm:text-4xl',
      ]}
    >
      {title}
    </h2>
    <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-ink-soft">
      {text}
    </p>
  </div>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2" aria-label="Gesprächsweg">
    {
      paths.map((path) => (
        <li>
          <a
            href={`#${path.id === 'schwestern' ? 'jessica' : 'mario'}`}
            data-path-choice={path.id}
            data-path-announcement={`${path.label}, ${path.person}`}
            data-selected="false"
            class="group relative grid h-full min-h-28 gap-1 rounded-2xl border border-ink-soft bg-white p-6 text-left text-ink transition duration-200 hover:-translate-y-0.5 hover:shadow-ambient focus:outline-3 focus:outline-offset-3 focus:outline-ink data-[selected=true]:border-2 data-[selected=true]:border-ink data-[selected=true]:bg-teal-brand motion-reduce:transform-none motion-reduce:transition-none"
          >
            <span class="text-base font-medium text-ink-soft">
              {path.label}
            </span>
            <strong class="pr-10 text-2xl leading-tight">{path.person}</strong>
            <span
              aria-hidden="true"
              class="absolute top-5 right-5 grid size-7 place-items-center rounded-full border border-ink bg-white opacity-0 transition-opacity group-data-[selected=true]:opacity-100 motion-reduce:transition-none"
            >
              ✓
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p data-path-status class="sr-only" aria-live="polite"></p>
</section>

<script>
  const choices = Array.from(
    document.querySelectorAll<HTMLElement>('[data-path-choice]'),
  );
  const status = document.querySelector<HTMLElement>('[data-path-status]');

  const selectPath = (selected: string) => {
    for (const choice of choices) {
      const isSelected = choice.dataset.pathChoice === selected;
      choice.dataset.selected = String(isSelected);
      if (isSelected) choice.setAttribute('aria-current', 'true');
      else choice.removeAttribute('aria-current');
    }
    const selectedChoice = choices.find(
      (choice) => choice.dataset.pathChoice === selected,
    );
    if (status && selectedChoice)
      status.textContent = `${selectedChoice.dataset.pathAnnouncement} ausgewählt.`;
    sessionStorage.setItem('ummahcare-path', selected);
  };

  const storedPath = sessionStorage.getItem('ummahcare-path');
  if (storedPath) selectPath(storedPath);

  for (const choice of choices) {
    choice.addEventListener('click', () => {
      const selected = choice.dataset.pathChoice;
      if (selected) selectPath(selected);
    });
  }
</script>
