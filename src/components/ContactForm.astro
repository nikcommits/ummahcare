---
interface Props {
  path: 'schwestern' | 'brueder';
  title: string;
  text: string;
  fields: Array<{ label: string; optional: boolean; help?: string }>;
  privacyPlaceholder: string;
  submitLabel: string;
  unavailable: string;
}

const {
  path,
  title,
  text,
  fields,
  privacyPlaceholder,
  submitLabel,
  unavailable,
} = Astro.props;
---

<section
  aria-labelledby="formular-titel"
  class="rounded-2xl bg-teal-soft p-6 md:p-8"
>
  <h2
    id="formular-titel"
    class="text-3xl leading-tight font-semibold tracking-[-0.02em]"
  >
    {title}
  </h2>
  <p class="mt-4 max-w-[65ch] text-lg leading-relaxed text-ink-soft">{text}</p>
  <p
    role="status"
    class="mt-5 rounded-xl border border-danger/35 bg-white p-4 font-semibold text-danger"
  >
    {unavailable}
  </p>

  <form
    class="mt-7 max-w-2xl space-y-6"
    aria-describedby={`${path}-formular-status`}
  >
    <p id={`${path}-formular-status`} class="sr-only">
      Formular ist noch nicht freigeschaltet.
    </p>
    {
      fields.map((field, index) => {
        const id = `${path}-feld-${index}`;
        const isMessage = field.label.startsWith('Worum');
        return (
          <div>
            <label for={id} class="block text-base font-semibold">
              {field.label}{' '}
              {field.optional && (
                <span class="font-normal text-ink-soft">(optional)</span>
              )}
            </label>
            {isMessage ? (
              <textarea
                id={id}
                disabled
                rows="4"
                aria-describedby={field.help ? `${id}-hilfe` : undefined}
                class="mt-2 w-full cursor-not-allowed rounded-lg border border-ink/30 bg-white/65 px-4 py-3 text-lg text-ink opacity-75 disabled:cursor-not-allowed"
              />
            ) : (
              <input
                id={id}
                disabled
                type="text"
                aria-describedby={field.help ? `${id}-hilfe` : undefined}
                class="mt-2 min-h-13 w-full cursor-not-allowed rounded-lg border border-ink/30 bg-white/65 px-4 py-3 text-lg text-ink opacity-75 disabled:cursor-not-allowed"
              />
            )}
            {field.help && (
              <p
                id={`${id}-hilfe`}
                class="mt-2 text-sm leading-relaxed text-ink-soft"
              >
                {field.help}
              </p>
            )}
          </div>
        );
      })
    }
    <p
      class="rounded-lg border border-ink/20 bg-white p-4 text-sm leading-relaxed text-ink-soft"
    >
      {privacyPlaceholder}
    </p>
    <button
      type="submit"
      disabled
      class="min-h-13 w-full cursor-not-allowed rounded-xl bg-ink/55 px-5 py-3 font-semibold text-white"
    >
      {submitLabel}
    </button>
  </form>
</section>
