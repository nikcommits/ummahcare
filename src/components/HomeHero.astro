---
import type { CollectionEntry } from 'astro:content';
import PathChooser from './PathChooser.astro';

type Hero = CollectionEntry<'home'>['data']['hero'];
type Paths = CollectionEntry<'home'>['data']['paths'];

interface Props {
  hero: Hero;
  paths: Paths;
}

const { hero, paths } = Astro.props;
---

<section class="overflow-hidden">
  <div
    class="mx-auto grid w-full max-w-[1200px] items-center gap-10 px-5 py-12 md:px-8 md:py-20 lg:grid-cols-12 lg:gap-12 xl:px-12 xl:py-24"
  >
    <div class="lg:col-span-7">
      <p class="font-semibold text-ink-soft">{hero.eyebrow}</p>
      <h1
        class="mt-4 max-w-[13ch] text-[clamp(2.5rem,7vw,5rem)] leading-[1.04] font-semibold tracking-[-0.03em] text-balance"
      >
        {hero.title}
      </h1>
      <h2
        class="mt-6 max-w-[24ch] text-2xl leading-snug font-semibold text-balance sm:text-3xl"
      >
        {hero.subtitle}
      </h2>
      <p
        class="mt-5 max-w-[62ch] text-lg leading-relaxed text-ink-soft sm:text-xl"
      >
        {hero.lead}
      </p>
      <div class="mt-10">
        <PathChooser
          title={hero.choiceTitle}
          text={hero.choiceText}
          paths={paths}
          compact
        />
      </div>
    </div>

    <div class="relative lg:col-span-5">
      <div
        class="absolute -inset-10 -z-10 rounded-full bg-teal-soft blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative grid aspect-square place-items-center overflow-hidden rounded-[2rem] bg-teal-brand p-8 sm:p-12"
      >
        <div
          class="absolute top-5 right-5 size-24 rounded-full border border-gold-brand/60"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute bottom-8 left-6 h-px w-28 bg-gold-brand"
          aria-hidden="true"
        >
        </div>
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/ummahcare-logo.png`}
          width="1254"
          height="1254"
          alt="UmmahCare, Hände tragen ein Gehirn in Herzform"
          class="relative z-10 h-full w-full object-contain"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
